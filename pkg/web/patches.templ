package web

import (
	"fmt"
	"strings"

	"github.com/getpatchwork/patchwork/pkg/db"
)

type patchListData struct {
	Project     db.Project
	Patches     []db.Patch
	Filters     []appliedFilter
	Sort        string
	Page        int
	PerPage     int
	Total       int
	TotalPages  int
	BaseQuery   string
	SeriesNames map[int32]string
	TagAbbrevs  []string
}

type appliedFilter struct {
	Label     string
	Value     string
	RemoveURL string
}

templ patchListPage(d patchListData) {
	@layout(d.Project.Name, d.Project.Linkname, []breadcrumb{
		{Label: d.Project.Name},
	}) {
		<patch-count>
			if len(d.Filters) > 0 {
				Show patches with
				for i, f := range d.Filters {
					if i > 0 {
						{ " / " }
					}
					{ f.Label } = <strong>{ f.Value }</strong>
					<a href={ templ.SafeURL(f.RemoveURL) } title="Remove filter">&times;</a>
				}
				{ " / " }
			}
			{ intStr(d.Total) } patches
		</patch-count>
		<patch-filters>
			<form method="get" action={ templ.SafeURL("/project/" + d.Project.Linkname + "/list/") }>
				<input type="text" name="q" placeholder="Search" title="Search"/>
				<select name="state" title="State">
					<option value="">State: All</option>
					<option value="*">State: Action required</option>
				</select>
				<select name="archive" title="Archive">
					<option value="">Active</option>
					<option value="true">Archived</option>
					<option value="both">Both</option>
				</select>
				<input type="text" name="submitter" placeholder="Submitter" title="Submitter"/>
				<input type="text" name="delegate" placeholder="Delegate" title="Delegate"/>
				<button type="submit">Filter</button>
			</form>
		</patch-filters>
		<patch-list>
			<table>
				<thead>
					<tr>
						@sortHeader("Patch", "name", d)
						<th>Series</th>
						<th>
							for i, a := range d.TagAbbrevs {
								if i > 0 {
									{ "/" }
								}
								{ a }
							}
						</th>
						<th><span title="Success / Warning / Fail">S/W/F</span></th>
						@sortHeader("Date", "date", d)
						@sortHeader("Submitter", "submitter", d)
						@sortHeader("Delegate", "delegate", d)
						@sortHeader("State", "state", d)
					</tr>
				</thead>
				<tbody>
					for _, p := range d.Patches {
						<tr>
							<td>
								<a href={ templ.SafeURL(patchURL(d.Project.Linkname, p.Msgid)) }>
									{ truncate(p.Name, 100) }
								</a>
							</td>
							<td>
								if p.SeriesID != nil {
									<a href={ templ.SafeURL(fmt.Sprintf("/project/%s/list/?series=%d", d.Project.Linkname, *p.SeriesID)) }>
										if name, ok := d.SeriesNames[*p.SeriesID]; ok && name != "" {
											{ truncate(name, 80) }
										} else {
											{ fmt.Sprintf("#%d", *p.SeriesID) }
										}
									</a>
								}
							</td>
							<td>
								@tagCounts(d.TagAbbrevs, p.Tags)
							</td>
							<td>
								@checkCounts(p.CheckCounts)
							</td>
							<td>{ p.Date.Format("2006-01-02") }</td>
							<td>
								if p.Submitter != nil {
									<a href={ templ.SafeURL(fmt.Sprintf("/project/%s/list/?submitter=%d", d.Project.Linkname, p.SubmitterID)) }>
										{ personName(p.Submitter) }
									</a>
								}
							</td>
							<td>
								if p.Delegate != nil {
									<a href={ templ.SafeURL(fmt.Sprintf("/project/%s/list/?delegate=%d", d.Project.Linkname, *p.DelegateID)) }>
										{ p.Delegate.Username }
									</a>
								}
							</td>
							<td>
								if p.State != nil {
									{ p.State.Name }
								}
							</td>
						</tr>
					}
					if len(d.Patches) == 0 {
						<tr>
							<td colspan="8">No patches to display.</td>
						</tr>
					}
				</tbody>
			</table>
		</patch-list>
		if d.TotalPages > 1 {
			@pagination(d.Page, d.TotalPages, d.BaseQuery)
		}
	}
}

templ tagCounts(abbrevs []string, tags map[string]int) {
	for i, a := range abbrevs {
		if i > 0 {
			{ " " }
		}
		if c, ok := tags[a]; ok && c > 0 {
			{ intStr(c) }
		} else {
			{ "-" }
		}
	}
}

templ checkCounts(counts [4]int) {
	if counts[1] > 0 {
		<check-ok>{ intStr(counts[1]) }</check-ok>
	} else {
		{ "-" }
	}
	{ "/" }
	if counts[2] > 0 {
		<check-warn>{ intStr(counts[2]) }</check-warn>
	} else {
		{ "-" }
	}
	{ "/" }
	if counts[3] > 0 {
		<check-fail>{ intStr(counts[3]) }</check-fail>
	} else {
		{ "-" }
	}
}

templ sortHeader(label string, field string, d patchListData) {
	<th>
		if strings.TrimPrefix(d.Sort, "-") == field {
			if strings.HasPrefix(d.Sort, "-") {
				<a href={ templ.SafeURL(sortURL(d, field)) }>{ label } &#9650;</a>
			} else {
				<a href={ templ.SafeURL(sortURL(d, "-"+field)) }>{ label } &#9660;</a>
			}
		} else {
			<a href={ templ.SafeURL(sortURL(d, field)) }>{ label }</a>
		}
	</th>
}

templ pagination(page int, totalPages int, baseQuery string) {
	<nav>
		if page > 1 {
			<a href={ templ.SafeURL(pageURL(baseQuery, page-1)) }>&laquo; Prev</a>
		}
		for i := 1; i <= totalPages; i++ {
			if i == page {
				<span>{ intStr(i) }</span>
			} else if i <= 3 || i > totalPages-3 || (i >= page-2 && i <= page+2) {
				<a href={ templ.SafeURL(pageURL(baseQuery, i)) }>{ intStr(i) }</a>
			} else if i == 4 || i == totalPages-3 {
				<span>&hellip;</span>
			}
		}
		if page < totalPages {
			<a href={ templ.SafeURL(pageURL(baseQuery, page+1)) }>Next &raquo;</a>
		}
	</nav>
}

type patchDetailData struct {
	Project        db.Project
	Patch          db.Patch
	Comments       []db.PatchComment
	Checks         []db.Check
	Series         *db.Series
	SeriesMetadata map[string]string
}

templ downloadLinks(d patchDetailData) {
	<download-links>
		<button><code>{ fmt.Sprintf("%d", d.Patch.ID) }</code></button>
		<button><a href={ templ.SafeURL(patchURL(d.Project.Linkname, d.Patch.Msgid) + "raw/") }>diff</a></button>
		<button><a href={ templ.SafeURL(patchURL(d.Project.Linkname, d.Patch.Msgid) + "mbox/") }>mbox</a></button>
		if d.Series != nil {
			<button><a href={ templ.SafeURL(fmt.Sprintf("/series/%d/mbox/", d.Series.ID)) }>series</a></button>
		}
	</download-links>
}

templ patchDetailPage(d patchDetailData) {
	@layout(d.Patch.Name, d.Project.Linkname, nil) {
		<title-bar>
			<h1>{ d.Patch.Name }</h1>
			@downloadLinks(d)
		</title-bar>
		<submission-meta>
			<table>
				<tbody>
					<tr>
						<th>Message ID</th>
						<td><code>{ d.Patch.Msgid }</code></td>
					</tr>
					if d.Patch.State != nil {
						<tr>
							<th>State</th>
							<td>
								{ d.Patch.State.Name }
								if d.Patch.Archived {
									{ " (archived)" }
								}
							</td>
						</tr>
					}
					if d.Patch.Delegate != nil {
						<tr>
							<th>Delegated to</th>
							<td>{ d.Patch.Delegate.Username }</td>
						</tr>
					}
					if d.Patch.CommitRef != nil && *d.Patch.CommitRef != "" {
						<tr>
							<th>Commit</th>
							<td><code>{ *d.Patch.CommitRef }</code></td>
						</tr>
					}
					if d.Series != nil {
						<tr>
							<th>Series</th>
							<td>
								<a href={ templ.SafeURL(fmt.Sprintf("/project/%s/list/?series=%d", d.Project.Linkname, d.Series.ID)) }>
									if d.Series.Name != nil {
										{ *d.Series.Name }
									} else {
										{ fmt.Sprintf("Series #%d", d.Series.ID) }
									}
								</a>
							</td>
						</tr>
						if len(d.SeriesMetadata) > 0 {
							for k, v := range d.SeriesMetadata {
								<tr>
									<th>{ k }</th>
									<td>
										if isURL(v) {
											<a href={ templ.SafeURL(v) }>{ v }</a>
										} else {
											<code>{ v }</code>
										}
									</td>
								</tr>
							}
						}
					}
				</tbody>
			</table>
		</submission-meta>
		if len(d.Checks) > 0 {
			<h2>Checks</h2>
			<table>
				<thead>
					<tr>
						<th>Context</th>
						<th>Check</th>
						<th>Description</th>
					</tr>
				</thead>
				<tbody>
					for _, c := range d.Checks {
						<tr>
							<td>{ c.Context }</td>
							<td>
								<span class={ checkClass(c.State) }>{ checkLabel(c.State) }</span>
							</td>
							<td>
								if c.TargetURL != "" {
									<a href={ templ.SafeURL(c.TargetURL) }>{ c.Description }</a>
								} else {
									{ c.Description }
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
		<h2>Commit Message</h2>
		if d.Patch.Submitter != nil {
			<comment-header>
				<a href={ templ.SafeURL(fmt.Sprintf("/project/%s/list/?submitter=%d", d.Project.Linkname, d.Patch.SubmitterID)) }>
					{ personName(d.Patch.Submitter) }
				</a>
				{ " - " }{ d.Patch.Date.Format("Jan. 2, 2006, 3:04 p.m. UTC") }
			</comment-header>
		}
		if d.Patch.Content != nil {
			<pre>{ *d.Patch.Content }</pre>
		}
		if len(d.Comments) > 0 {
			<h2>Comments</h2>
			for _, c := range d.Comments {
				<article id={ fmt.Sprintf("comment-%d", c.ID) }>
					<comment-header>
						if c.Submitter != nil {
							<a href={ templ.SafeURL(fmt.Sprintf("/project/%s/list/?submitter=%d", d.Project.Linkname, c.SubmitterID)) }>
								{ personName(c.Submitter) }
							</a>
							{ " - " }
						}
						{ c.Date.Format("Jan. 2, 2006, 3:04 p.m. UTC") }
					</comment-header>
					if c.Content != nil {
						<pre>{ *c.Content }</pre>
					}
				</article>
			}
		}
		if d.Patch.Diff != nil && *d.Patch.Diff != "" {
			<title-bar>
				<h2>Patch</h2>
				@downloadLinks(d)
			</title-bar>
			<patch-diff>
				<pre>
					@templ.Raw(highlightDiff(*d.Patch.Diff))
				</pre>
			</patch-diff>
		}
	}
}

templ personDisplay(p *db.Person) {
	if p.Name != nil && *p.Name != "" {
		{ *p.Name }
		<small>&lt;{ p.Email }&gt;</small>
	} else {
		{ p.Email }
	}
}
